# Use Java 17 as the runtime environment.
FROM eclipse-temurin:17-jre

# Set the working directory inside the container.
WORKDIR /app

# Copy the JAR generated by the Maven build.
COPY target/BuildProcessDemo-0.0.1-SNAPSHOT.jar /app/app.jar

# Document the port used by the Java web server.
EXPOSE 8081

# Start the Java web application.
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
